{
  "name": "vision-urbaine-video",
  "version": "1.0.0",
  "private": true,
  "description": "Vision Urbaine — 640x320 LED storefront loop, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "remotion render VisionUrbaine out/vision-urbaine.mp4 --codec=h264 --muted",
    "symps:assets": "node scripts/scan-symps-assets.mjs",
    "symps:render": "node scripts/scan-symps-assets.mjs && node scripts/render-symps.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "4.0.290",
    "@remotion/fonts": "^4.0.290",
    "@remotion/three": "^4.0.290",
    "@types/three": "^0.169.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
